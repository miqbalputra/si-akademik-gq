APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# RPP: private Cloudflare R2 bucket. Leave local defaults untouched for development.
# Create an R2 API token with Object Read & Write restricted to this bucket.
RPP_FILESYSTEM_DISK=local
RPP_R2_BUCKET=
RPP_R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
RPP_R2_ACCESS_KEY_ID=
RPP_R2_SECRET_ACCESS_KEY=
RPP_R2_REGION=auto
RPP_R2_USE_PATH_STYLE_ENDPOINT=true
RPP_SHARE_MINUTES=60

# Realtime source integration (Project RPP -> aplikasi sekolah). Keep tokens server-side.
RPP_SYNC_ENABLED=false
RPP_SOURCE_URL=https://rpp.sekolah.sch.id
RPP_SOURCE_API_TOKEN=
RPP_SYNC_WEBHOOK_SECRET=
RPP_SYNC_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Optional: restrict Google login to this Workspace hosted domain (e.g. griyaquran.sch.id).
# Leave empty to allow any registered email. When set, only matching accounts may log in.
GOOGLE_HOSTED_DOMAIN=

# Required: bearer/API-key token for the n8n integration endpoint
# (api/v1/diniyyah/journals/missing-reminders). Must be set — there is no
# default; a missing token makes the endpoint deny all access (fail-closed).
N8N_API_TOKEN=

# Server-to-server GeoPresensi integration for teacher journal reminders and
# the read-only "Presensi Saya" report. Keep the API key server-side; never
# expose it via Vite or browser JavaScript.
ATTENDANCE_JOURNAL_INTEGRATION_ENABLED=false
ATTENDANCE_API_BASE_URL=https://geo.griyaquran.web.id
ATTENDANCE_API_KEY=
ATTENDANCE_API_TIMEOUT=5
ATTENDANCE_API_CACHE_SECONDS=60
